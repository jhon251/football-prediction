      "rule_id": "R_MENTALITY_LEAD_TEMPO",
      "name": "leading_team_tempo_moderation",
      "category": "rules",
      "description": "A leading team typically moderates tempo; magnitude depends on the coach's defensive tendency.",
      "status": "tentative",
      "source": "internal_default_v1",
      "confidence": 0.55,
      "evidence_count": 0,
      "condition": {"all": [
        {"field": "mentality_home", "op": "eq", "value": "leading"},
        {"field": "home_coach.reaction_to_leading", "op": "eq", "value": "defensive"}
      ]},
      "effects": [
        {"target": "home_tactical_state.tempo_contribution", "op": "add", "value": -0.15, "confidence": 0.55, "reason": "leading + defensive coach"},
        {"target": "home_tactical_state.risk_level", "op": "add", "value": -0.10, "confidence": 0.55, "reason": "leading + defensive coach"},
        {"target": "home_tactical_state.attacking_intensity", "op": "add", "value": -0.08, "confidence": 0.50, "reason": "leading + defensive coach"}
      ],
      "tags": ["state_transition", "mentality"],
      "active": true
    },
